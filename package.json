{
  "name": "hangman",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,server -c green,blue \"npm:dev:vite-only\" \"npm:dev:server\"",
    "dev:client": "npm run dev",
    "dev:vite-only": "vite",
    "dev:server": "tsx watch server/server.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "NODE_ENV=production node dist-server/server/server.js",
    "start:server": "node dist-server/server/server.js",
    "test:e2e": "node scripts/e2e.mjs",
    "test:browser:multiplayer": "node scripts/multiplayer-browser-test.mjs",
    "test:game": "node scripts/forgiveness-test.mjs",
    "test:chat": "node scripts/chat-test.mjs",
    "test:lifecycle": "node scripts/lifecycle-test.mjs",
    "test:match": "node scripts/match-features-test.mjs",
    "test:n-player": "node scripts/n-player-test.mjs",
    "test:absence": "node scripts/absence-test.mjs",
    "test:connection": "tsx --tsconfig tsconfig.app.json tests/connection-test.ts",
    "test:reconnect": "tsx --tsconfig tsconfig.app.json tests/reconnect-test.ts",
    "test:lobby-settings": "tsx --tsconfig tsconfig.app.json tests/lobby-settings-test.ts",
    "test:multiplayer-ui": "tsx --tsconfig tsconfig.app.json tests/multiplayer-ui-test.tsx",
    "test:match-results": "tsx --tsconfig tsconfig.app.json tests/match-results-test.tsx",
    "test:vocab": "python3 -m unittest discover -s tests -p 'test_vocab_pipeline.py'",
    "test:character": "tsx --tsconfig tsconfig.app.json tests/character-test.tsx",
    "test:seasonal": "tsx --tsconfig tsconfig.app.json tests/seasonal-test.ts",
    "test:learning": "tsx --tsconfig tsconfig.app.json tests/learning-test.ts",
    "test:vocabulary": "tsx --tsconfig tsconfig.app.json tests/vocabulary-contract-test.ts",
    "test:daily": "tsx --tsconfig tsconfig.app.json tests/daily-test.ts",
    "test:seo": "node tests/seo-test.mjs",
    "test:invitation": "tsx --tsconfig tsconfig.app.json tests/invitation-test.ts",
    "test:localization": "tsx --tsconfig tsconfig.app.json tests/localization-test.ts",
    "test:navigation": "tsx --tsconfig tsconfig.app.json tests/navigation-test.ts",
    "vocab:fetch": "python3 scripts/fetch-catalan-corpus.py",
    "vocab:extract": "python3 scripts/extract-catalan-vocabulary.py",
    "vocab:enrich": "python3 scripts/enrich-translations.py",
    "vocab:enrich-llm": "python3 scripts/enrich-llm.py",
    "vocab:cefr-sample": "python3 scripts/select-cefr-sample.py",
    "vocab:cefr-experiment": "python3 scripts/run-cefr-experiment.py",
    "vocab:cefr-experiment-run2": "python3 scripts/run-cefr-experiment-run2.py",
    "vocab:cefr-report": "python3 scripts/report-cefr-experiment.py",
    "vocab:cefr-stability": "python3 scripts/report-cefr-stability.py",
    "vocab:cefr-data-quality": "python3 scripts/run-cefr-data-quality.py",
    "vocab:cefr-data-quality-report": "python3 scripts/report-cefr-data-quality.py",
    "vocab:cefr-full": "python3 scripts/run-cefr-full.py",
    "vocab:cefr-quality-full": "python3 scripts/run-cefr-quality-full.py",
    "vocab:cefr-full-report": "python3 scripts/report-cefr-full.py",
    "vocab:cefr-combined": "python3 scripts/run-cefr-combined.py",
    "vocab:repair-propose": "python3 scripts/run-repair-proposals.py",
    "vocab:repair-validate": "python3 scripts/validate-repair-proposals.py",
    "vocab:repair-report": "python3 scripts/report-repair-proposals.py",
    "vocab:repair-candidate": "python3 scripts/vocab_pipeline.py repair-candidate",
    "vocab:repair-candidate-validate": "python3 scripts/vocab_pipeline.py repair-candidate-validate",
    "vocab:repair-candidate-report": "python3 scripts/vocab_pipeline.py repair-candidate-report",
    "vocab:repair-semantic-input": "python3 scripts/vocab_pipeline.py repair-semantic-input",
    "vocab:repair-semantic-verify": "python3 scripts/vocab_pipeline.py repair-semantic-verify",
    "vocab:repair-semantic-report": "python3 scripts/vocab_pipeline.py repair-semantic-report",
    "vocab:repair-cefr-queue": "python3 scripts/vocab_pipeline.py repair-cefr-queue",
    "vocab:repair-cefr-recheck": "python3 scripts/vocab_pipeline.py repair-cefr-recheck",
    "vocab:repair-cefr-recheck-validate": "python3 scripts/vocab_pipeline.py repair-cefr-recheck-validate",
    "vocab:clean": "python3 scripts/clean-translations.py",
    "vocab:build": "python3 scripts/build-vocabulary.py",
    "vocab:validate": "python3 scripts/validate-vocabulary.py",
    "vocab": "python3 scripts/vocab_pipeline.py all",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:browser": "node scripts/browser-audit-test.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.6",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.4"
  }
}
